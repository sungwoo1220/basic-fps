#include <windows.h>
#include "Resources.h"
#pragma code_page(65001)

ID_CONNECT DIALOGEX 0,0,252,121
STYLE DS_MODALFRAME | DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "Basic FPS - 다른 방에 연결"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "방 주소", -1, 10, 10, 218, 12
    EDITTEXT ID_ADDRESS, 10, 24, 232, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "닉네임", -1, 10, 51, 218, 12
    EDITTEXT ID_NICKNAME, 10, 65, 232, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "방에 연결", IDOK, 116, 96, 62, 15
    PUSHBUTTON "취소", IDCANCEL, 182, 96, 60, 15
END

ID_HOST DIALOGEX 0,0,252,84
STYLE DS_MODALFRAME | DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "Basic FPS - 방 만들기"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "닉네임", -1, 10, 10, 218, 12
    EDITTEXT ID_NICKNAME, 10, 24, 232, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "방 만들기", IDOK, 116, 58, 62, 15
    PUSHBUTTON "취소", IDCANCEL, 182, 58, 60, 15
END
