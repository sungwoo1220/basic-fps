#include <windows.h>
#include "Resources.h"
#pragma code_page(65001)

ID_CONNECT DIALOGEX 0,0,252,121
STYLE DS_MODALFRAME | DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "Basic FPS - 다른 방에 연결"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "방 주소", -1, 10, 10, 218, 12
    EDITTEXT ID_ADDRESS, 10, 24, 232, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "닉네임", -1, 10, 51, 218, 12
    EDITTEXT ID_NICKNAME, 10, 65, 232, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "방에 연결", IDOK, 116, 96, 62, 15
    PUSHBUTTON "취소", IDCANCEL, 182, 96, 60, 15
END

ID_HOST DIALOGEX 0,0,252,104
STYLE DS_MODALFRAME | DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "Basic FPS - 방 만들기"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "닉네임", -1, 10, 10, 218, 12
    EDITTEXT ID_NICKNAME, 10, 24, 232, 15, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "방 목록에 공개 (다른 사람이 목록에서 골라 들어와요)", ID_LISTED, 10, 48, 232, 14, WS_TABSTOP
    DEFPUSHBUTTON "방 만들기", IDOK, 116, 78, 62, 15
    PUSHBUTTON "취소", IDCANCEL, 182, 78, 60, 15
END

ID_SENS DIALOGEX 0,0,200,84
STYLE DS_MODALFRAME | DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "Basic FPS - 마우스 감도"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "감도 (0.001 ~ 10, 브라우저 게임과 같은 값)", -1, 10, 10, 180, 12
    EDITTEXT ID_SENSVALUE, 10, 24, 180, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "저장", IDOK, 64, 58, 60, 15
    PUSHBUTTON "취소", IDCANCEL, 130, 58, 60, 15
END

ID_ROOMS DIALOGEX 0,0,300,206
STYLE DS_MODALFRAME | DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "Basic FPS - 방 목록"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "열린 방 (방을 만든 사람의 PC가 서버예요)", -1, 10, 8, 280, 12
    LISTBOX ID_ROOMLIST, 10, 22, 280, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", ID_ROOMNOTE, 10, 130, 280, 22
    LTEXT "닉네임", -1, 10, 158, 40, 12
    EDITTEXT ID_NICKNAME, 52, 156, 120, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "새로고침", ID_REFRESH, 10, 182, 62, 15, WS_TABSTOP
    DEFPUSHBUTTON "들어가기", IDOK, 164, 182, 62, 15
    PUSHBUTTON "취소", IDCANCEL, 230, 182, 60, 15
END
